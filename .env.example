# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ---------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------

# Your Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_bot_token_here

# ---------------------------------------------------------
# RECOMMENDED
# ---------------------------------------------------------

# Your Discord server (guild) ID.
# Set this so slash commands register instantly (guild scope).
# Leave blank to register globally (can take up to 1 hour).
DISCORD_GUILD_ID=

# Discord role ID whose members can enter official game results.
# If not set, anyone with "Manage Guild" permission can use admin commands.
ADMIN_ROLE_ID=

# ---------------------------------------------------------
# OPTIONAL CHANNEL RESTRICTIONS
# ---------------------------------------------------------

# If set, result announcements are posted to this channel.
ANNOUNCEMENTS_CHANNEL_ID=

# If set, prediction commands are only usable in this channel.
PREDICTIONS_CHANNEL_ID=

# If set, result commands post output to this channel.
RESULTS_CHANNEL_ID=

# ---------------------------------------------------------
# TUNING
# ---------------------------------------------------------

# How often (in seconds) the background auto-scorer runs.
# Default: 120
BACKGROUND_TASK_INTERVAL=120
